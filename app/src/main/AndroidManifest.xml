<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- The daily reading reminder. Notifications are asked for at the moment the
         reminder is switched on, on Android 13 and later. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BibleReader">

        <activity
            android:name=".ui.MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.MarksActivity"
            android:exported="false"
            android:label="@string/notes_and_highlights" />

        <activity
            android:name=".ui.FoldersActivity"
            android:exported="false"
            android:label="@string/folders" />

        <activity
            android:name=".ui.HistoryActivity"
            android:exported="false"
            android:label="@string/history" />

        <activity
            android:name=".ui.SearchActivity"
            android:exported="false"
            android:label="@string/search_words"
            android:windowSoftInputMode="stateVisible" />

        <service
            android:name=".audio.AudioService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Delivers the daily reminder, and puts the alarm back after a reboot or
             an app update (system broadcasts only, hence exported="false"). -->
        <receiver
            android:name=".notify.ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
